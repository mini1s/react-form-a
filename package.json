{
    "name": "@minisquare/react-form-a",
    "version": "1.0.5",
    "description": "Reusable form component A",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "rimraf dist && tsc && tsc --module CommonJS --outDir dist/cjs --declaration false --emitDeclarationOnly false"
    },
    "peerDependencies": {
        "@minisquare/react-context": "^1.0.14",
        "firebase": "^12.8.0",
        "react": "^19.0.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.13.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.11",
        "@types/uuid": "^10.0.0",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3"
    }
}
